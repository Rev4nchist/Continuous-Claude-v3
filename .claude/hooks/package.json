{
    "name": "claude-hooks",
    "version": "1.0.0",
    "description": "TypeScript hooks for Claude Code - pre-bundled, zero runtime deps",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node node_modules/esbuild/bin/esbuild src/*.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs --external:better-sqlite3 --banner:js=\"import{createRequire as __hookCreateRequire}from'module';const require=__hookCreateRequire(import.meta.url);\"",
        "check": "tsc --noEmit",
        "dev": "npm run build && npm run check",
        "test": "vitest run --reporter=verbose",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@colbymchenry/codegraph": "0.9.9",
        "@types/node": "^20.11.0",
        "@types/pg": "^8.20.0",
        "esbuild": "^0.24.0",
        "typescript": "^5.3.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "better-sqlite3": "^12.5.0",
        "pg": "^8.22.0"
    },
    "overrides": {
        "vite": "7.3.6"
    }
}
