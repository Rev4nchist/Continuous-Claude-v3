{
    "name": "claude-hooks",
    "version": "1.0.0",
    "description": "TypeScript hooks for Claude Code - pre-bundled, zero runtime deps",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "esbuild src/*.ts --bundle --platform=node --format=esm --outdir=dist --out-extension:.js=.mjs --external:better-sqlite3 --banner:js=\"import{createRequire as __hookCreateRequire}from'module';const require=__hookCreateRequire(import.meta.url);\" && node scripts/write-build-inputs.mjs",
        "check": "tsc --noEmit",
        "dev": "npm run build && npm run check",
        "test": "vitest run --reporter=verbose",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@colbymchenry/codegraph": "1.6.2",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3",
        "pg": "^8.23.1"
    },
    "overrides": {
        "vite": "7.3.6"
    }
}
