  "statusLine": {
    "type": "command",
    "command": "node {{CLAUDE_HOME}}/plugins/claude-hud/launcher.mjs"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "braintrust@braintrust-claude-plugin": false,
    "trace-claude-code@braintrust-claude-plugin": false,
    "microsoft-docs@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoCompact": false,
  "allowedTools": [],
  "warningLevel": "medium",
  "mcpServers": {
    "git": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "firecrawl": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "disabled": true
    },
    "morph": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@morphllm/morphmcp"
      ],
      "env": {
        "MORPH_API_KEY": "${MORPH_API_KEY}"
      },
      "disabled": true
    },
    "perplexity": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@perplexity-ai/mcp-server"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      },
      "disabled": true
    },
    "nia": {
      "type": "stdio",
      "command": "pipx",
      "args": [
        "run",
        "--no-cache",
        "nia-mcp-server"
      ],
      "env": {
        "NIA_API_KEY": "${NIA_API_KEY}",
        "NIA_API_URL": "https://apigcp.trynia.ai/"
      },
      "disabled": true
    },
    "ast-grep": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@anthropic/mcp-ast-grep"
      ],
      "disabled": true
    },
    "repoprompt": {
      "type": "stdio",
      "command": "repoprompt_cli",
      "args": [],
      "disabled": true
    },
    "qlty": {
      "type": "stdio",
      "command": "{{CLAUDE_HOME}}/venv/bin/python",
      "args": [
        "{{CLAUDE_HOME}}/servers/qlty/server.py"
      ],
      "disabled": true
    },
    "pageindex": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@pageindex/mcp"
      ]
    }
  },
  "effortLevel": "high",
  "skillOverrides": {
    "anthropic-skills:frontend-design": "off",
    "anthropic-skills:frontend-slides": "off",
    "anthropic-skills:fourth-presentation-suite": "off",
    "anthropic-skills:scroll-craft": "off",
    "anthropic-skills:notion-bridge": "off",
    "anthropic-skills:skill-forge": "off"
  },
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.05,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  }
}
