{
  "cleanupPeriodDays": 180,
  "env": {
    "CONTINUOUS_CLAUDE_COORDINATION": "true",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_OPC_DIR": "{{OPC_DIR}}",
    "CCV3_ROADMAP_AUTOCOMMIT": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-plan-memory.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/lane-agent-tag.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/agent-model-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/explore-to-scout.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/no-haiku-enforcer.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/navigator-validate.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/task-router.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-tool-knowledge.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/agent-recall-injector.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/smart-search-router.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/tldr-read-enforcer.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/package-install-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/destructive-command-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-pr-gate.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/scan-scope-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/commit-preflight.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/destructive-command-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-pr-gate.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/package-install-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/scan-scope-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/commit-preflight.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_desktop-commander_desktop-commander__start_process|mcp__plugin_desktop-commander_desktop-commander__interact_with_process",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/destructive-command-guard.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/package-install-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__plugin_desktop-commander_desktop-commander__set_config_value",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/dc-config-guard.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/file-claims.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/test-before-done.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/plan-mode-approval-gate.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Task|Agent|Skill|mcp__Neon__.*|mcp__linear__.*|mcp__claude_ai_Linear__.*|mcp__sentry__.*|mcp__playwright__.*|mcp__claude-in-chrome__.*|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/rule-router.mjs"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/prompt-submit.mjs"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-docker.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-register.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-continuity.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-init-check.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/roadmap-reconcile.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/hook-health-monitor.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 20,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-context-loaders.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-memory-loaders.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-start-intel-prune.mjs"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/identity-probe.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/lane-context.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/rule-router.mjs"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-compact-extract.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pre-compact-continuity.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-register.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-end-extract.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-outcome.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/session-end-handoff-indexer.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/coordination-release.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/mcp-activity-tracker.mjs"
            ],
            "timeout": 3
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/periodic-extract.mjs"
            ],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/agent-error-capture.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/agent-verification.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 3,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/lane-board-republish-reminder.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/epistemic-reminder.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/post-plan-roadmap.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/plan-exit-premortem-prompt.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/architecture-stats-sync.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/smarter-everyday.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/prd-roadmap-sync.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/git-auto-commit.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/tree-invalidate.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pageindex-watch.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/import-validator.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "timeout": 35,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/post-edit-diagnostics.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Skill|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/telemetry-tracker.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 5,
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/web-lookup-advisor.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "TaskUpdate|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/roadmap-completion.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/git-commit-roadmap.mjs"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/test-run-tracker.mjs"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/msys-crash-capture.mjs"
            ]
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/pr-opened-review-loop.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/bus-tool-populator.mjs"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/lane-context.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/coordination-notification.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "{{CLAUDE_HOME}}/hooks/dist/test-run-tracker.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node {{CLAUDE_HOME}}/plugins/claude-hud/launcher.mjs"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "braintrust@braintrust-claude-plugin": false,
    "trace-claude-code@braintrust-claude-plugin": false,
    "microsoft-docs@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "typesafe@typesafe-ai": true,
    "ccv3-mods@ccv3": true
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "autoCompact": false,
  "allowedTools": [],
  "warningLevel": "medium",
  "effortLevel": "high",
  "advisorModel": "fable",
  "skillOverrides": {
    "anthropic-skills:frontend-design": "off",
    "anthropic-skills:frontend-slides": "off",
    "anthropic-skills:fourth-presentation-suite": "off",
    "anthropic-skills:scroll-craft": "off",
    "anthropic-skills:notion-bridge": "off",
    "anthropic-skills:skill-forge": "off"
  },
  "skillListingMaxDescChars": 2048,
  "skillListingBudgetFraction": 0.05,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "ccv3": {
      "source": {
        "source": "directory",
        "path": "{{CLAUDE_HOME}}/plugins/ccv3-mods"
      }
    }
  }
}
