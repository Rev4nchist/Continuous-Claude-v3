{
  "permissions": {
    "allow": ["Bash(git log *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/dist/destructive-command-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
