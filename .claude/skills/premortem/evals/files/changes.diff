 """Delete build-cache entries that nobody has used for a while."""
 import os
 import shutil
 import time

 CACHE_ROOT = os.environ.get("BUILD_CACHE_ROOT", "/srv/build-cache")
-MAX_AGE_SECONDS = 7 * 24 * 3600
