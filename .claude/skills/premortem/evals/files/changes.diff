+def stale_entries(root=CACHE_ROOT, now=None):
+    now = now or time.time()
+    for name in sorted(os.listdir(root)):
+        path = os.path.join(root, name)
+        if not os.path.isdir(path):
+            continue
+        # atime is off on the cache volume (mounted noatime), so use mtime.
+        if now - os.path.getmtime(path) > MAX_AGE_DAYS:
+            yield name
+
+
+def remove_entry(root, name):
+    # Refuse names that would resolve to the root itself or outside it.
+    if not name or name in (".", "..") or os.sep in name:
+        raise ValueError(f"refusing to remove cache entry {name!r}")
+    shutil.rmtree(os.path.join(root, name))


 def main():
-    for path in stale_entries():
-        print("stale:", path)
+    removed = 0
+    for name in stale_entries():
+        remove_entry(CACHE_ROOT, name)
+        removed += 1
+    print(f"removed {removed} stale cache entries")
     return 0


 if __name__ == "__main__":
     raise SystemExit(main())
