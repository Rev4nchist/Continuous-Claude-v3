{
  "mcpServers": {
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@upstash/context7-mcp@latest"],
      "type": "stdio"
    },
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"],
      "type": "stdio"
    },
    "shadcn": {
      "command": "shadcn",
      "args": ["mcp"],
      "type": "stdio"
    },
    "nia": {
      "command": "cmd",
      "args": ["/c", "uv", "tool", "run", "nia-mcp-server"],
      "env": {
        "NIA_API_KEY": "${NIA_API_KEY}",
        "NIA_API_URL": "https://apigcp.trynia.ai/"
      },
      "type": "stdio"
    },
    "firecrawl": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "morph": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@morphllm/morphmcp"],
      "env": {
        "MORPH_API_KEY": "${MORPH_API_KEY}"
      }
    },
    "perplexity": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "pageindex": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@pageindex/mcp"]
    }
  }
}
