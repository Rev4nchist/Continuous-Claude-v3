{
  "$comment": "Read by hooks/dist/rule-router.mjs. Each entry loads its rule files the FIRST time a matching tool call happens in a session. mode 'deny-first' refuses that first call with the rule text as the reason (for rules that must change the decision); 'inject' adds the text as context and lets the call run. Matchers: command = regexes tested against each command segment with quoted strings removed and leading env/&/cmd /c prefixes dropped; raw = regexes tested against the whole command as typed; agent = subagent_type; skill = Skill name; tools = tool_name (MCP tools). Keep the always-loaded index rules-src/on-demand-rules.md in step with this file.",
  "rules": [
    {
      "id": "codex",
      "files": ["codex-worker-safety.md", "codex-adversarial.md"],
      "mode": "deny-first",
      "command": ["^codex(\\.cmd|\\.exe)?(\\s|$)"],
      "agent": ["^codex-"],
      "skill": ["^codex(:|$)"]
    },
    {
      "id": "harness-update",
      "files": ["harness-update.md"],
      "mode": "inject",
      "command": ["^(npm|pnpm)\\s+(i|install)\\s+(-g|--global)\\s+@openai/codex", "^grok(\\.cmd|\\.exe)?\\s+update\\b"],
      "skill": ["^harness-update$"]
    },
    {
      "id": "grok",
      "files": ["grok-worker-safety.md"],
      "mode": "deny-first",
      "command": ["^grok(\\.cmd|\\.exe)?(\\s|$)"],
      "agent": ["^grok-"],
      "skill": ["^grok$"]
    },
    {
      "id": "cma",
      "files": ["cma-safety.md"],
      "mode": "deny-first",
      "command": ["^ant(\\.exe)?(\\s|$)"],
      "raw": ["api\\.anthropic\\.com/v1/(agents|sessions|environments|deployments|vaults)"],
      "agent": ["^cma-operator$"],
      "skill": ["^(cma|launch-your-agent|wrap-up)$"]
    },
    {
      "id": "notion-cli",
      "files": ["notion-cli-safety.md"],
      "mode": "inject",
      "command": ["^ntn(\\.exe)?(\\s|$)"],
      "skill": ["^notion-cli$"]
    },
    {
      "id": "railway",
      "files": ["railway-deploy.md"],
      "mode": "inject",
      "command": ["^railway(\\s|$)"]
    },
    {
      "id": "neonctl",
      "files": ["neonctl-safety.md"],
      "mode": "inject",
      "command": ["^(neonctl|neon)(\\s|$)"],
      "tools": ["^mcp__Neon__"]
    },
    {
      "id": "kusto",
      "files": ["kusto-cli-safety.md"],
      "mode": "inject",
      "command": ["^kusto\\.cli(\\.exe)?(\\s|$)"],
      "raw": ["[Kk]usto\\.[Cc]li"],
      "skill": ["^kusto-cli$"]
    },
    {
      "id": "sentry",
      "files": ["sentry-safety.md"],
      "mode": "inject",
      "command": ["^sentry-cli(\\s|$)"],
      "tools": ["^mcp__sentry__"],
      "skill": ["^sentry-cli$"]
    },
    {
      "id": "linear",
      "files": ["linear-safety.md"],
      "mode": "inject",
      "command": ["^(linear|linearis)(\\s|$)"],
      "tools": ["^mcp__linear__", "^mcp__claude_ai_Linear__"],
      "skill": ["^linear$"]
    },
    {
      "id": "git-merge",
      "files": ["git-merge-workflow.md"],
      "mode": "inject",
      "command": ["^git(\\s+-[Cc]\\s+\\S+)*\\s+merge(\\s|$)", "^gh\\s+pr\\s+merge\\b", "^gh\\s+api\\s+\\S*/pulls/\\d+/merge\\b"],
      "raw": ["land-pr\\.ps1"]
    },
    {
      "id": "pr-and-commit-style",
      "files": ["pr-and-commit-style.md"],
      "mode": "deny-first",
      "command": [
        "^git(\\s+-[Cc]\\s+\\S+)*\\s+commit(\\s|$)",
        "^(pwsh|powershell)(\\.exe)?\\s.*\\scommit(\\s|$)",
        "^gh\\s+pr\\s+create\\b",
        "^gh\\s+api\\b(?=.*\\s-X\\s+POST\\b)(?=.*/pulls(\\s|$))"
      ]
    },
    {
      "id": "pr-coderabbit-loop",
      "files": ["pr-coderabbit-loop.md"],
      "mode": "inject",
      "command": ["^gh\\s+pr\\s+create\\b", "^gh\\s+api\\b(?=.*\\s-X\\s+POST\\b)(?=.*/pulls(\\s|$))"],
      "raw": ["coderabbit-status\\.mjs", "land-pr\\.ps1"]
    },
    {
      "id": "cross-terminal-db",
      "files": ["cross-terminal-db.md"],
      "mode": "inject",
      "command": ["^(psql|pg_dump|pg_restore)(\\.exe)?(\\s|$)"],
      "raw": ["docker(\\.exe)?\"?\\s+exec\\b.*postgres"]
    },
    {
      "id": "headless-claude",
      "files": ["headless-claude-mcp.md"],
      "mode": "inject",
      "command": ["^claude(\\.exe)?\\s(.*\\s)?(-p|--print)(\\s|$)"]
    }
  ]
}
