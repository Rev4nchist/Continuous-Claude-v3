{
  "_doc": "Rows for the stricter-of-main-and-branch rule (coord-cap-override, PR A). The .mjs helper (scripts/github/config-stricter.mjs) and its TypeScript twin (.claude/hooks/src/shared/config-stricter.ts) must give the same view on every row. view = { enforce: checkpoint.enforce is the boolean true, cap: coderabbit.cli_daily_cap_usd when a finite number of 0 or more else null, summaryFail: pre_pr.summary_mode is 'fail' }. main null means no main side could be read.",
  "rows": [
    { "id": "A1", "name": "main enforce true, branch false: true", "main": { "checkpoint": { "enforce": true } }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A2", "name": "main enforce false, branch true: true", "main": { "checkpoint": { "enforce": false } }, "branch": { "checkpoint": { "enforce": true } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A2b", "name": "main false, branch false: false", "main": { "checkpoint": { "enforce": false } }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": false, "cap": null, "summaryFail": false } },
    { "id": "A3a", "name": "cap: main 3, branch 99 gives 3", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 99 } }, "expect": { "enforce": false, "cap": 3, "summaryFail": false } },
    { "id": "A3b", "name": "cap: main 3, branch 1 gives 1", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 1 } }, "expect": { "enforce": false, "cap": 1, "summaryFail": false } },
    { "id": "A3c", "name": "cap 0 on main wins", "main": { "coderabbit": { "cli_daily_cap_usd": 0 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 5 } }, "expect": { "enforce": false, "cap": 0, "summaryFail": false } },
    { "id": "A3d", "name": "cap 0 on the branch wins", "main": { "coderabbit": { "cli_daily_cap_usd": 5 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 0 } }, "expect": { "enforce": false, "cap": 0, "summaryFail": false } },
    { "id": "A4a", "name": "summary mode: main fail, branch note gives fail", "main": { "pre_pr": { "summary_mode": "fail" } }, "branch": { "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": false, "cap": null, "summaryFail": true } },
    { "id": "A4b", "name": "summary mode: main note, branch fail gives fail", "main": { "pre_pr": { "summary_mode": "note" } }, "branch": { "pre_pr": { "summary_mode": "fail" } }, "expect": { "enforce": false, "cap": null, "summaryFail": true } },
    { "id": "A4c", "name": "summary mode: note and note stays note", "main": { "pre_pr": { "summary_mode": "note" } }, "branch": { "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": false, "cap": null, "summaryFail": false } },
    { "id": "A5b", "name": "no main side: enforce true, branch cap and mode kept", "main": null, "branch": { "checkpoint": { "enforce": false }, "coderabbit": { "cli_daily_cap_usd": 7 }, "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": true, "cap": 7, "summaryFail": false } },
    { "id": "A11a", "name": "branch enforce is the string false: counts as true", "main": { "checkpoint": { "enforce": false } }, "branch": { "checkpoint": { "enforce": "false" } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A11b", "name": "branch enforce null: counts as true", "main": { "checkpoint": { "enforce": false } }, "branch": { "checkpoint": { "enforce": null } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A11c", "name": "branch enforce the number 0: counts as true", "main": { "checkpoint": { "enforce": false } }, "branch": { "checkpoint": { "enforce": 0 } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A11d", "name": "branch cap is the string 999: ignored, main cap stays", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": "999" } }, "expect": { "enforce": false, "cap": 3, "summaryFail": false } },
    { "id": "A11e", "name": "branch cap is -1: ignored, main cap stays", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": -1 } }, "expect": { "enforce": false, "cap": 3, "summaryFail": false } },
    { "id": "A11f", "name": "branch cap is the string NaN: ignored, main cap stays", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": { "cli_daily_cap_usd": "NaN" } }, "expect": { "enforce": false, "cap": 3, "summaryFail": false } },
    { "id": "A12a", "name": "branch deletes enforce: main true stays", "main": { "checkpoint": { "enforce": true } }, "branch": { "checkpoint": {} }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A12b", "name": "branch deletes the whole checkpoint block: main true stays", "main": { "checkpoint": { "enforce": true } }, "branch": {}, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "A12c", "name": "branch deletes the cap: main cap stays", "main": { "coderabbit": { "cli_daily_cap_usd": 3 } }, "branch": { "coderabbit": {} }, "expect": { "enforce": false, "cap": 3, "summaryFail": false } },
    { "id": "A12d", "name": "branch deletes the summary mode: main fail stays", "main": { "pre_pr": { "summary_mode": "fail" } }, "branch": {}, "expect": { "enforce": false, "cap": null, "summaryFail": true } },
    { "id": "B1a", "name": "main enforce is the string true, branch false: true (a present main value that is not false is strict)", "main": { "checkpoint": { "enforce": "true" } }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "B1b", "name": "main enforce null, branch false: true", "main": { "checkpoint": { "enforce": null } }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "B1c", "name": "main enforce the number 0, branch false: true", "main": { "checkpoint": { "enforce": 0 } }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "B1d", "name": "main checkpoint is not an object, branch false: true", "main": { "checkpoint": "x" }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": true, "cap": null, "summaryFail": false } },
    { "id": "B1e", "name": "control: main checkpoint has no enforce key, branch false: false", "main": { "checkpoint": {} }, "branch": { "checkpoint": { "enforce": false } }, "expect": { "enforce": false, "cap": null, "summaryFail": false } },
    { "id": "B2a", "name": "main cap is the string 3, branch 99: cap 0 (a present main cap that is not valid counts as 0)", "main": { "coderabbit": { "cli_daily_cap_usd": "3" } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 99 } }, "expect": { "enforce": false, "cap": 0, "summaryFail": false } },
    { "id": "B2b", "name": "main cap is -1, no branch cap: cap 0", "main": { "coderabbit": { "cli_daily_cap_usd": -1 } }, "branch": {}, "expect": { "enforce": false, "cap": 0, "summaryFail": false } },
    { "id": "B2c", "name": "main cap is null, branch 5: cap 0", "main": { "coderabbit": { "cli_daily_cap_usd": null } }, "branch": { "coderabbit": { "cli_daily_cap_usd": 5 } }, "expect": { "enforce": false, "cap": 0, "summaryFail": false } },
    { "id": "B2d", "name": "control: main has a coderabbit block with no cap key, branch 5: the branch cap stays", "main": { "coderabbit": {} }, "branch": { "coderabbit": { "cli_daily_cap_usd": 5 } }, "expect": { "enforce": false, "cap": 5, "summaryFail": false } },
    { "id": "B3a", "name": "main summary mode is warn (unknown), branch note: fail", "main": { "pre_pr": { "summary_mode": "warn" } }, "branch": { "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": false, "cap": null, "summaryFail": true } },
    { "id": "B3b", "name": "main summary mode is null, branch note: fail", "main": { "pre_pr": { "summary_mode": null } }, "branch": { "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": false, "cap": null, "summaryFail": true } },
    { "id": "B3c", "name": "control: main has a pre_pr block with no mode key, branch note: note", "main": { "pre_pr": {} }, "branch": { "pre_pr": { "summary_mode": "note" } }, "expect": { "enforce": false, "cap": null, "summaryFail": false } },
    { "id": "A6", "name": "a key outside the list keeps the branch value", "main": { "checkpoint": { "ledger": false } }, "branch": { "checkpoint": { "ledger": true }, "deep_enabled": true }, "expect": { "enforce": false, "cap": null, "summaryFail": false }, "keep": [["checkpoint", "ledger", true], ["deep_enabled", null, true]] }
  ]
}
